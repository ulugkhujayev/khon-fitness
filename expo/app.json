{
  "expo": {
    "name": "Khon Fitness",
    "slug": "khon-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khonfitness",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.mirzohidkhon.khonfitness.expo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.mirzohidkhon.khonfitness.expo",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FF9F0A"
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Khon Fitness reads your workouts and heart rate to log them as cardio sessions.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Today",
              "description": "Workout of the day with a Start button",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EatingWindow",
              "label": "Eating window",
              "description": "Eating window: open or closed, and the next change time",
              "minWidth": "140dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Workout of the day with a Start button",
              "supportedFamilies": [
                "systemSmall"
              ],
              "contentMarginsDisabled": false
            },
            {
              "name": "WindowWidget",
              "displayName": "Eating window",
              "description": "Eating window: open or closed, and the next change time",
              "supportedFamilies": [
                "systemSmall"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "./plugins/withDebugHealthWrite.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#000000",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
